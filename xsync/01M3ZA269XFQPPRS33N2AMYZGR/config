keybind = opt+left=text:\x1b\x62
keybind = opt+right=text:\x1b\x66

# Send proper escape sequences for opt+q and opt+w (for tmux window navigation)
keybind = opt+q=text:\x1bq
keybind = opt+w=text:\x1bw